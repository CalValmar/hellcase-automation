[Unit]
Description=Open Hellcase Newbie case
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min

[Service]
Type=oneshot
WorkingDirectory=%h/hellcase-automation
ExecStart=/usr/bin/python3 %h/hellcase-automation/daily_reward.py
Restart=on-failure
RestartSec=1min
StartLimitBurst=3
TimeoutStartSec=10min
SyslogIdentifier=hellcase-daily
Environment=PYTHONUNBUFFERED=1
